#!/bin/bash
# =============================================================================
# .githooks/commit-msg — valida convencion Tim Pope para commit messages
# =============================================================================
# Adaptado del framework THYROX (referencia .claude/ de los submodulos
# api/ui/docs de kaupamex). Este submodulo db se saltó en la adopcion
# previa; este hook cierra esa brecha.
#
# Cargado via 'git config core.hooksPath .githooks' (ver
# scripts/install-hooks.sh). Mantiene el repo consistente con la
# convencion Tim Pope documentada en la gobernanza de kaupamex
# (../kaupamex/.claude/rules/commit-conventions.md — ver CLAUDE.md).
#
# Reglas validadas (las 4 mas mecanicas; el body es responsabilidad
# del autor — demasiado heuristico):
#
#   1. Subject <= 72 caracteres (limite absoluto; recomendado <=50).
#   2. Subject empieza con mayuscula.
#   3. Subject NO termina con punto.
#   4. Subject en imperativo (heuristica: primer verbo no termina en
#      'ed' o 'ing').
#
# Excepciones (no se valida):
#   - Merge commits ("Merge ...").
#   - Revert commits ("Revert ...").
#   - Fixup/squash autogenerados ("fixup!", "squash!", "amend!").
#
# Para skip manual: 'git commit --no-verify' (NO usar salvo emergencia
# documentada).
# =============================================================================
set -euo pipefail

COMMIT_MSG_FILE="$1"
[[ -f "$COMMIT_MSG_FILE" ]] || exit 0

# Primera linea no-vacia (subject).
SUBJECT="$(grep -m1 -v '^$' "$COMMIT_MSG_FILE" || true)"
[[ -n "$SUBJECT" ]] || exit 0

# Excepciones — auto-generados por git.
case "$SUBJECT" in
    "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*)
        exit 0
        ;;
esac

EXIT=0
fail() {
    echo "" >&2
    echo "ERROR commit-msg: $*" >&2
    echo "  Subject: '$SUBJECT'" >&2
    echo "  Ver: CLAUDE.md (Gobernanza) — commit-conventions Tim Pope" >&2
    EXIT=1
}

# 1) Largo del subject (limite absoluto 72 ch).
LEN="${#SUBJECT}"
if (( LEN > 72 )); then
    fail "subject de $LEN caracteres excede el limite de 72"
fi

# 2) Empieza con mayuscula (letra A-Z).
FIRST_CHAR="${SUBJECT:0:1}"
if ! [[ "$FIRST_CHAR" =~ [A-Z] ]]; then
    fail "subject debe empezar con mayuscula (encontrado: '$FIRST_CHAR')"
fi

# 3) No termina con punto.
LAST_CHAR="${SUBJECT: -1}"
if [[ "$LAST_CHAR" == "." ]]; then
    fail "subject no debe terminar con punto"
fi

# 4) Heuristica imperativa: la primera palabra (donde vive el verbo en
# imperativo: "Add", "Fix", "Remove", ...) no debe terminar en 'ed' o
# 'ing'. Las palabras siguientes pueden terminar asi legitimamente.
LOWER_SUBJECT="$(echo "$SUBJECT" | tr '[:upper:]' '[:lower:]')"
FIRST_WORD="${LOWER_SUBJECT%% *}"
#
# La terminacion NO decide sola: hay verbos imperativos que acaban en
# 'ing' o 'ed'. MEDIDO 2026-08-27: el subject "Bring the seven cron
# seeds inside the H-API-22 net" fue rechazado con "primer verbo:
# 'bring'", y "Bring" es imperativo. El comentario que estaba aqui ya
# reconocia el hueco ("No whitelist por ahora"); esta es la whitelist.
#
# 'seed' es el caso que mas importa en este arbol: sembrar es una
# operacion con siete data-migrations propias, asi que un subject
# "Seed ..." iba a chocar tarde o temprano.
IMPERATIVOS_EN_ING_O_ED="bring sing ring string shed feed speed seed \\
embed exceed proceed spread read lead need breed bleed succeed"
case " $IMPERATIVOS_EN_ING_O_ED " in
    *" $FIRST_WORD "*) FIRST_WORD="" ;;
esac
case "$FIRST_WORD" in
    *ing|*ed)
        fail "subject parece no-imperativo (primer verbo: '$FIRST_WORD'). Usar imperativo (Add, Fix, Remove, ...)"
        ;;
esac

# -----------------------------------------------------------------------------
# Segundo eje: la cita durable RESUELVE, no solo tiene la FORMA
# -----------------------------------------------------------------------------
# Una cadena `TASK-<CAPA>-NNNN` con forma impecable puede no nombrar a nadie: el
# NNNN es la secuencia del store, no el ordinal del board, y rellenar el ordinal
# a cuatro digitos la fabrica. Medido sobre 400 commits del proveedor: 13 de 114
# citas distintas no resuelven, todas con esa forma (H-THYROX-62).
#
# EL MECANISMO VIVE EN EL PROVEEDOR, no aqui. Este bloque es un STUB: resuelve
# donde esta thyrox y le pasa el mensaje. Mismo reparto que el `pre-commit` de
# kaupamex-docs, que es el precedente ya decidido de como un consumidor invoca
# un gate del proveedor.
#
# El envoltorio sale 0 o 2, NUNCA 1: un 1 abortaria este hook bajo `set -e`
# antes de su propio veredicto Tim Pope. Por eso el aviso de deuda heredada
# viaja por stderr y el codigo dice «sigue», y la graduacion es una linea alla.
DUENO=""
if [ -n "${THYROX_ROOT:-}" ]; then
    DUENO="$THYROX_ROOT/bin/commit-msg-citation"
else
    NIVEL="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    while [ "$NIVEL" != "/" ]; do
        if [ -f "$NIVEL/thyrox/bin/commit-msg-citation" ]; then
            DUENO="$NIVEL/thyrox/bin/commit-msg-citation"; break
        fi
        NIVEL="$(dirname "$NIVEL")"
    done
fi
if [ -z "$DUENO" ] || [ ! -f "$DUENO" ]; then
    cat >&2 <<'MSG'
commit-msg REHUSADO — no se encontro thyrox/bin/commit-msg-citation.
No se emite un veredicto: un gate que no puede medir no autoriza el commit.
Declarar THYROX_ROOT, o clonar thyrox junto a los repos de kaupamex.
Emergencia: `git commit --no-verify` (y anotar el motivo en el progreso).
MSG
    exit 2
fi
CITA=0
bash "$DUENO" "$1" || CITA=$?
[ "$CITA" -eq 0 ] || exit 2

exit "$EXIT"
