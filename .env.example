# =============================================================================
# .env.example — Kaupamex-db
# =============================================================================
# Copia este archivo a .env y completa los valores antes de ejecutar
# cualquier script del repositorio.
#
#   cp .env.example .env
#   nano .env   # o tu editor preferido
#
# El archivo .env está en .gitignore — nunca lo subas al repositorio.
# =============================================================================

# ─── Base de datos — producción / desarrollo ─────────────────────────────────
# Coincide con las variables de src/.env en kaupamex-api.
#
# El motor es PostgreSQL (ADR-028): estas son **bases**, no schemas. Un schema
# de PostgreSQL es un namespace DENTRO de una base (el default es 'public').
#
# DB_SOCKET: en libpq el socket ES el host — un HOST que empieza con '/' es el
# *directorio* del socket y DB_PORT nombra el archivo (.s.PGSQL.5432). No hay
# opción 'unix_socket' como en mysqlclient. Vacía = conectar por TCP.
DB_NAME=kaupamex_core
DB_USER=django_user
DB_PASSWORD=django_pass
DB_SOCKET=/var/run/postgresql
DB_HOST=127.0.0.1
DB_PORT=5432

# ─── Base de datos — QA / pruebas ────────────────────────────────────────────
# Usado por provisioners/postgresql/db_setup.sh --qa, scripts/backup_postgres.sh
# y scripts/verify_postgres.sh.
#
# INVARIANTE: DB_QA_PASSWORD DEBE ser igual a DB_PASSWORD. En PostgreSQL el rol
# no tiene componente de host — django_user es UN rol con UNA contraseña, y las
# dos bases se conectan con él. Contraseñas distintas dan authentication failed.
# scripts/init-env.sh genera un único valor aleatorio para ambas variables.
#
# Coincide con las variables que lee config/settings/testing.py en la API.
DB_QA_NAME=kaupamex_core_qa
DB_QA_USER=django_user
DB_QA_PASSWORD=django_pass
DB_QA_SOCKET=/var/run/postgresql
DB_QA_HOST=127.0.0.1
DB_QA_PORT=5432

# ─── Usuario de backup (privilegios mínimos) ─────────────────────────────────
# Este rol NO es el usuario de Django. Para pg_dump necesita poder LEER todo
# lo que va a volcar; el motor viejo (MariaDB) además exigía LOCK TABLES y
# RELOAD, que PostgreSQL no necesita porque el dump corre en una transacción
# de snapshot. Se crea con scripts/backup_postgres.sh --setup-user.
PY_BACKUP_USER=py_backup_user
PY_BACKUP_PASSWORD=changeme_backup_pass

# ─── Directorio de backups ───────────────────────────────────────────────────
# Ruta absoluta donde se escriben los archivos .sql.gz, .md5 y .log.
# Debe existir y ser escribible por el usuario que ejecuta backup_db.sh.
# Por defecto usa el directorio backups/ del propio repositorio.
BACKUP_DIR=./backups

# ─── Destino remoto opcional ─────────────────────────────────────────────────
# Si está definido, scripts/backup_db.sh sincroniza los backups a este destino
# después de verificar la integridad MD5. Dejar vacío para backups solo locales.
# El proveedor concreto (S3, GCS, rsync remoto, SFTP) se define en el ADR
# correspondiente (CNST-ARQ-001 P3 v3.0.0 — excepción para backups).
# Ejemplo S3:    s3://mi-bucket/kaupamex/backups/
# Ejemplo rsync: usuario@servidor:/ruta/backups/
BACKUP_REMOTE_DEST=

# ─── Repos hermanos para backup de proyectos ──────────────────────────────────
# Nombres de directorio local de los repos hermanos a incluir en
# scripts/backup_proyectos.sh. Separados por espacios. Ajustar según
# cómo estén clonados localmente.
BACKUP_REPOS="kaupamex-api kaupamex-docs kaupamex-ui"

# ─── Django — requerido por scripts/check_db.py ──────────────────────────────
# check_db.py importa la configuración de Django para verificar que el ORM
# puede conectarse con los mismos parámetros que usa la aplicación.
# Debe coincidir con el SECRET_KEY real de Kaupamex-api.
SECRET_KEY=django-insecure-CHANGE-ME-in-production
DJANGO_SETTINGS_MODULE=config.settings.development
