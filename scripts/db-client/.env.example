# =============================================================================
# .env.example — ecom-prod / practicayoruba.com
# Scripts Python cliente local — db.practicayoruba.com:3306 (SSL)
# =============================================================================
# Copiar este archivo como .env y rellenar los valores reales.
# NUNCA commitear .env — está en .gitignore.
#
# Conexión: cliente local → internet → Host DNAT → VM3 MariaDB
# SSL:      Let's Encrypt público — sin CA extra en el cliente
# =============================================================================

# --- Servidor ---
DB_HOST=db.practicayoruba.com
DB_PORT=3306

# --- Schema producción (acceso DML) ---
DB_NAME=kaupamex_db
DB_USER=practicayoruba_app
DB_PASSWORD=CHANGE-THIS

# --- Schema QA (acceso ALL PRIVILEGES) ---
DB_QA_NAME=kaupamex_qa
DB_QA_USER=practicayoruba_app
DB_QA_PASSWORD=CHANGE-THIS

# --- Usuario readonly (solo SELECT en producción) ---
DB_READONLY_USER=practicayoruba_readonly
DB_READONLY_PASSWORD=CHANGE-THIS

# --- SSL ---
# Certificado Let's Encrypt público — no se requiere CA extra.
# Dejar vacío para usar el bundle de CAs del sistema (recomendado).
DB_SSL_CA=

# --- Django (solo para migrate_db.py) ---
DJANGO_MANAGE_PATH=../manage.py
# DJANGO_SETTINGS_MODULE=config.settings.local
